# Environment configuration for Physical AI & Humanoid Robotics Course Textbook

# API Configuration
QDRANT_URL=http://localhost:6333
NEON_DB_URL=postgresql://username:password@localhost:5432/textbook_db
FASTAPI_URL=http://localhost:8000

# Authentication
AUTH_SECRET_KEY=your-secret-key-here
BASIC_AUTH_USERNAME=textbook-user
BASIC_AUTH_PASSWORD=secure-password

# RAG Configuration
RAG_ENABLED=true
RAG_HIGHLIGHT_MODE=true

# Deployment
NODE_ENV=development